  </string>
  <string id="str_comment_noble_introduces_self_and_clan.black_boasting" text="{=a8584KD0}I am {CONVERSATION_CHARACTER.LINK}, of the {CLAN_NAME}. I am sure you have heard the name of our family from many a gleemans tales of the Black Tower. We carry the honor of defending these lands from the scourge of the shadow.">
    <tags>
      <tag tag_name="UncharitableTag" />
