  <string id="str_comment_noble_introduces_self_and_clan.white_boasting" text="{=a8584KD0}I am {CONVERSATION_CHARACTER.LINK}, of the {CLAN_NAME}. I am sure you have heard the name of our ajah from many a gleemans tales of the White Tower. We carry the honor of defending these lands from the shadow and its spawn.">
    <tags>
