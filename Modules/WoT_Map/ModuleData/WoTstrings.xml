      <tag tag_name="WhiteTag" />
    </tags>
  </string>
  <string id="str_comment_noble_introduces_self_and_clan.white" text="{=z2yr4mc6}I am {CONVERSATION_CHARACTER.LINK}, of the {CLAN_NAME}. Our clan has loyally served the {FACTION} for generations.">
