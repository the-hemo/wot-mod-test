  <string id="str_comment_noble_introduces_self_and_clan.black" text="{=z2yr4mc6}I am {CONVERSATION_CHARACTER.LINK}, of the {CLAN_NAME}. Our clan has loyally served the {FACTION} since its beginnings.">
